# Public marketing origin, distinct from the application login URL.
NEXT_PUBLIC_SITE_URL=https://footfalliq.in
NEXT_PUBLIC_APP_URL=https://attendance.footfalliq.in
# Optional verified company contact address. Omit until approved.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional GA4 web-stream ID. No Google script loads unless configured and consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional HTML ownership tokens, never invented. Domain-property verification uses DNS instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set false for nonpublic/staging builds. Vercel preview/development also automatically noindex.
SEO_INDEXING_ENABLED=true
# Server-only lead provider. Must persist/deliver the lead before returning 2xx.
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_TOKEN=
